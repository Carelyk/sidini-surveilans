# Kunci API Groq untuk fitur Analisis Naratif AI.
# Salin berkas ini menjadi .env lalu isi kuncimu.
# Halaman lain tetap berfungsi tanpa kunci ini.
GROQ_API_KEY=gsk_isi_dengan_kunci_anda

# Opsional. Default: openai/gpt-oss-120b
# Daftar model aktif bisa dicek lewat:
# curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
